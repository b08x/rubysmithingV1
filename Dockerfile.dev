# Development container for rubysmithing with full BDD workflow support
FROM ruby:3.4-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    git \
    postgresql-client \
    libpq-dev \
    nodejs \
    npm \
    python3 \
    python3-pip \
    sqlite3 \
    libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*

# Create workspace
WORKDIR /workspace

# Install Ruby dependencies
COPY Gemfile Gemfile.lock ./
RUN bundle config set --local deployment false && \
    bundle config set --local without production && \
    bundle install

# Install Node.js dependencies for any frontend tools
COPY package*.json ./
RUN npm install 2>/dev/null || echo "No package.json found"

# Create directories for SFL pipeline
RUN mkdir -p /workspace/sfl_pipeline/{input,processing,output} && \
    mkdir -p /workspace/user_stories && \
    mkdir -p /workspace/features/generated

# Install Python dependencies for SFL processing
COPY requirements.txt ./
RUN pip3 install -r requirements.txt 2>/dev/null || echo "No requirements.txt found"

# Set up Foreman for process management
COPY Procfile ./

# Expose ports
EXPOSE 3000 8080

# Default command
CMD ["bundle", "exec", "foreman", "start"]