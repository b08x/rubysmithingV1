# OpenRouter API Key for Mistral/Claude access
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Context7 API Key for documentation lookup
CONTEXT7_API_KEY=your_context7_api_key_here

# PostgreSQL connection string
DATABASE_URL=postgres:///rubysmithing_rag

# Path to the RubyGemDB project directory (defaults to ~/.config/rubysmithing/db in PreFlight)
# RUBY_GEM_DB_DIR=~/.config/rubysmithing/db
